{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/router.js": {
      "maxDuration": 60,
      "includeFiles": "{src/data/**,public/data/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/router?__route=$1" },
    { "source": "/((?!api/|data/|legacy/|assets/|home/|conflicts/|favicon).*)", "destination": "/index.html" }
  ]
}
