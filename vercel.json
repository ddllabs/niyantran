{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ai/chat.js": { "maxDuration": 60 },
    "api/ai/fetch.js": { "maxDuration": 30 },
    "api/ai/desk-brief.js": { "maxDuration": 60 },
    "api/ai/source-extract.js": { "maxDuration": 45 },
    "api/auth/google.js": { "maxDuration": 30 },
    "api/news/ingest.js": { "maxDuration": 30 },
    "api/ohlc.js": { "maxDuration": 20, "includeFiles": "public/data/**" },
    "api/home/latest.js": { "maxDuration": 15, "includeFiles": "public/data/nter-news.json" },
    "api/home/markets.js": { "maxDuration": 30, "includeFiles": "public/data/**" },
    "api/home/pulse.js": { "maxDuration": 30, "includeFiles": "public/data/**" },
    "api/home/refresh.js": { "maxDuration": 60, "includeFiles": "public/data/**" }
  },
  "rewrites": [
    { "source": "/((?!api/|data/|legacy/|assets/|home/|conflicts/|favicon).*)", "destination": "/index.html" }
  ]
}
