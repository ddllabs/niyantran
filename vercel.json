{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["bom1"],
  "functions": {
    "api/router.js": {
      "maxDuration": 60,
      "includeFiles": "{src/data/**,public/data/**,backup/GLOBAL/manifest.json,backup/GLOBAL/F08_Satellite_Infrastructure.xlsx,backup/GLOBAL/F11_Growth_Indicators.xlsx,backup/GLOBAL/F15_Global_Trade.xlsx,backup/SPORTS/manifest.json,backup/SPORTS/F64_Athlete_Index.xlsx}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/router?__route=$1" },
    { "source": "/((?!api/|data/|legacy/|assets/|home/|conflicts/|favicon).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/([^/]+)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/brand/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }] }
  ]
}
