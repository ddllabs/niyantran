# ==============================================================================
# Niyantran AI / NTER — Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# Authentication Email Delivery Provider Configuration
# ------------------------------------------------------------------------------
# Supported Modes:
#   1. SUPABASE_NATIVE (Default for development/demo)
#      - Uses native Supabase Auth email dispatch (supabase.auth.signUp, resetPasswordForEmail, resend).
#      - Does NOT require Resend API credentials.
#      - Email templates configured in Supabase Dashboard -> Authentication -> Email Templates.
#   2. RESEND_API (Future production mode when custom domain is verified)
#      - Uses server-side Supabase Admin generateLink() + Resend API.
#      - Dispatches responsive branded HTML templates from server/templates/.
#      - Requires RESEND_API_KEY, RESEND_FROM_EMAIL, and SUPABASE_SERVICE_ROLE_KEY.
AUTH_EMAIL_PROVIDER="SUPABASE_NATIVE"

# Application Host URL (Used for authentication action links: signup & recovery)
# Local: http://localhost:5173
# Production: set to https://niyantran.ai (or your custom production domain)
APP_URL="http://localhost:5173"
SITE_URL="http://localhost:5173"

# Resend Transactional Email Configuration (Server-Side Only — NEVER expose to browser)
# Required when AUTH_EMAIL_PROVIDER="RESEND_API"
# Local Testing Sender:
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Niyantran AI <onboarding@resend.dev>"
# Production Sender (after domain verification at resend.com/domains):
# RESEND_FROM_EMAIL="Niyantran AI <auth@niyantran.ai>"

# Supabase Project Configuration
PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project.supabase.co"

# Supabase Server-Side Secret Key (Server-Side Only — NEVER prefix with VITE_)
# Required for server-side administrative tasks and RESEND_API generateLink().
# Use an sb_secret_… key from Settings → API Keys. Legacy anon/service_role JWT
# keys were disabled on this project on 2026-09-21 and no longer work.
SUPABASE_SECRET_KEY="sb_secret_..."
# Legacy name, still read as a fallback by server/authEmailProvider.mjs:
# SUPABASE_SERVICE_ROLE_KEY=

# Supabase Client-Safe Anon / Publishable Key (Bundled with Vite frontend)
SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Optional Server-Only AI API Keys
GEMINI_API_KEY=
OPENROUTER_API_KEY=