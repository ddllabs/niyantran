# ==============================================================================
# Niyantran AI / NTER — Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# Authentication Email Delivery Provider Configuration
# ------------------------------------------------------------------------------
# Supported Modes:
#   1. SUPABASE_NATIVE (Default for development/demo)
#      - Uses native Supabase Auth email dispatch (supabase.auth.signUp, resetPasswordForEmail, resend).
#      - Does NOT require Resend API credentials.
#      - Email templates configured in Supabase Dashboard -> Authentication -> Email Templates.
#   2. RESEND_API (Future production mode when custom domain is verified)
#      - Uses server-side Supabase Admin generateLink() + Resend API.
#      - Dispatches responsive branded HTML templates from server/templates/.
#      - Requires RESEND_API_KEY, RESEND_FROM_EMAIL, and SUPABASE_SECRET_KEY.
AUTH_EMAIL_PROVIDER="SUPABASE_NATIVE"

# Application Host URL (Used for authentication action links: signup & recovery)
# Local: http://localhost:5173
# Production: set to https://niyantran.ai (or your custom production domain)
APP_URL="http://localhost:5173"
SITE_URL="http://localhost:5173"

# Resend Transactional Email Configuration (Server-Side Only — NEVER expose to browser)
# Required when AUTH_EMAIL_PROVIDER="RESEND_API"
# Local Testing Sender:
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Niyantran AI <onboarding@resend.dev>"
# Production Sender (after domain verification at resend.com/domains):
# RESEND_FROM_EMAIL="Niyantran AI <auth@niyantran.ai>"

# Supabase Project Configuration
PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project.supabase.co"

# Supabase Server-Side Secret Key (Server-Side Only — NEVER prefix with VITE_)
# Required for server-side administrative tasks and RESEND_API generateLink().
# Use an sb_secret_… key from Settings → API Keys. Legacy anon/service_role JWT
# keys were disabled on this project on 2026-09-21 and no longer work.
# Also read by scripts/ingest-national-desk.mjs together with SUPABASE_URL.
SUPABASE_SECRET_KEY="sb_secret_..."
# The only name for this secret; the legacy SUPABASE_SERVICE_ROLE_KEY is not read.

# Supabase Client-Safe Anon / Publishable Key (Bundled with Vite frontend)
SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# AI provider keys do not belong here. Every model call goes through the
# Supabase Edge Functions, and OPENROUTER_API_KEY lives only in Supabase
# secrets (ADR 0008). Nothing in this app reads a provider key.

# Razorpay. Key secret must stay server-only.
# Dashboard → Settings → API Keys (test keys for sandbox).
# Plans and rupee prices come from src/lib/publicPlans.js; no GST is charged
# (the seller is not GST-registered), so there are no GST or exchange-rate settings.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Checkout stays closed until this is 1, even with keys set (owner, F110: open
# once AI credits exist). Use test keys and 1 on a preview for Razorpay's review.
# BILLING_CHECKOUT_OPEN=1

# Optional overrides for the "From" block on invoices (defaults shown)
# BILLING_LEGAL_NAME=Niyantran Strategy Consulting Private Limited
# BILLING_TRADE_NAME=NIYANTRAN TERMINAL
# BILLING_ADDRESS=Kolkata, West Bengal, India
# BILLING_EMAIL=niyantranai@gmail.com

# Google Sign-In (GIS). Client ID is public in the browser; keep secrets server-only.
# Production origin authorized: https://nter.pro (localhost needs a separate OAuth client).
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# nter.news → Terminal article ingest (server-only).
# Shared bearer for POST /api/news/ingest. Never prefix with VITE_.
NTER_TERMINAL_API_KEY=

# YouTube Data API v3 (CR-08 Live TV — Server-Only — NEVER prefix with VITE_)
# Optional: Enables live stream query and recent uploads playlist fetching.
# If omitted or quota-exhausted, Live TV safely falls back to curated channel videos.
YOUTUBE_API_KEY=

# Desk APIs (feature-feed / home). Default on for Vercel. Set 0 to force static packs only.
# VITE_LIVE_API=0
