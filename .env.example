# Server-only. Never prefix with VITE_ (that would ship to the browser).
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional aliases also accepted by /api/ai/*
# GOOGLE_API_KEY=
# NIYANTRAN_AI_KEY=
# DEEPSEEK_API_KEY=

# Razorpay (CR-17). Key secret must stay server-only.
# Dashboard → Settings → API Keys (test keys for sandbox).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional FX for USD list prices → INR (default 83)
# BILLING_USD_INR=83

# GST tax invoice (CR-17 remainder) — supplier on invoices
# BILLING_LEGAL_NAME=Niyantran Research Technologies
# BILLING_TRADE_NAME=Niyantran Terminal
# BILLING_GSTIN=27AAAAA0000A1Z5
# BILLING_ADDRESS=Mumbai, Maharashtra, India
# BILLING_GST_STATE_CODE=27
# BILLING_EMAIL=billing@niyantran
# BILLING_SAC=998314

# Google Sign-In (GIS). Client ID is public in the browser; keep secrets server-only.
# Production origin authorized: https://nter.pro (localhost needs a separate OAuth client).
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
